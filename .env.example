# Google OAuth2 Client ID — get from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# API Base URL — leave empty if using Nginx reverse proxy (same-origin)
# Only set this when deploying frontend on a DIFFERENT domain than backend
# Example: VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=
